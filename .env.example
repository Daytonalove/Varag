# Copy values into your process environment. This file is NOT loaded automatically.
LOCAL_DEMO_MODE=true
APP_ENV=development
# Varyag always uses GigaChat; no per-document consent toggle.
ENABLE_CLAIMS_INDEX=false
BANK_DATABASE=data/bank/audit.sqlite3
BANK_API_PORT=8766
BANK_RETRIEVAL_MODE=auto
EMBEDDING_MODEL_DIRECTORY=models/multilingual-e5-small
BANK_RERANKER_MODE=required
RERANKER_MODEL_DIRECTORY=models/mmarco-mMiniLMv2-L12-H384-v1
GIGACHAT_AUTH_KEY=
GIGACHAT_KEY_FILE=
GIGACHAT_SCOPE=
GIGACHAT_MODEL=
GIGACHAT_CA_BUNDLE=
GIGACHAT_OAUTH_URL=
# Empty: use selected model's window. A value only lowers the automatic limit.
GIGACHAT_CONTEXT_TOKENS=
# Optional verified per-model windows as a JSON object; unknown IDs default to 32768.
GIGACHAT_MODEL_CONTEXT_LIMITS={}
# fast: at most one completion, local source checks; audit: legacy multi-stage path.
RAG_ANSWER_MODE=fast
FAST_RAG_COUNT_TOKENS=true
FAST_RAG_MAX_SOURCES=64
# Empty: min(3 * context window, 240000) characters, then fit by model tokens.
FAST_RAG_CONTEXT_CHARS=
FAST_RAG_SOURCE_CHARS=6000
# Empty: 6000 for windows >=128000, otherwise 2500; always reserve before sending.
FAST_RAG_OUTPUT_TOKENS=
# Legacy multi-stage audit budget:
GIGACHAT_QUESTION_TOKEN_BUDGET=120000
GIGACHAT_REQUESTS_PER_MINUTE=30
# Pin exact versions after regression acceptance; unset means monitoring only.
GIGACHAT_ALLOWED_MODEL_VERSIONS=
GIGACHAT_PRICE_PER_MILLION_RUB=
BANK_CLAMAV_HOST=
BANK_CLAMAV_PORT=3310
BANK_REQUIRE_AV=false
BANK_REPORT_FONT=
# Optional 0600 JSON mapping random API tokens to user IDs; never commit it.
BANK_LOCAL_USERS_FILE=
